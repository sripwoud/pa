#!/usr/bin/env bash
#
# Get a one-time password, or add an OTP secret to the pa store.
#
# All OTP entries are stored with the suffix '-otp'. Newly added ones get it
# appended. The two menu actions are prefixed with an emoji.
#
# OTP generation needs an accurate clock. The 'sync-time' action syncs it
# with ntpdate.
#
# Requires: paotp, dmenu, xdotool, notify-send.
# Adding requires maim and zbarimg. Syncing requires ntpdate and sudo.

set -o pipefail

readonly DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/pa/passwords"
readonly TMP_NAME='otp-test-script'

err() {
  printf '%s: %s.\n' "${0##*/}" "$1" >&2
}

die() {
  err "$1"
  exit 1
}

need() {
  local cmd
  for cmd; do
    command -v "${cmd}" >/dev/null || die "${cmd} is not installed"
  done
}

list_choices() {
  local file
  printf '%s\n' '🆕add' '🕙sync-time'
  for file in "${DIR}"/*-otp.age; do
    [[ -e ${file} ]] || continue
    file=${file##*/}
    printf '%s\n' "${file%-otp.age}"
  done
}

add_otp() {
  local temp info name
  need maim zbarimg

  temp=$(mktemp -p "${XDG_RUNTIME_DIR:-/tmp}" --suffix=.png) ||
    die "couldn't create a temp file"
  # shellcheck disable=SC2064 # expand now: temp is local
  trap "rm -f -- ${temp@Q} ${DIR@Q}/${TMP_NAME}.age" EXIT

  notify-send "Scan the image." "Scan the OTP QR code."

  maim -s "${temp}" || exit 1
  info=$(zbarimg -q "${temp}")
  info=${info#QR-Code:}

  if ! printf '%s\n' "${info}" | paotp insert "${TMP_NAME}"; then
    notify-send "No OTP data found." \
      "Try to scan the image again more precisely."
    return 1
  fi

  until [[ ${name} =~ ^[A-Za-z0-9-]+$ ]]; do
    name=$(dmenu -p "Give this One Time Password a one-word name:" \
      </dev/null) || exit 1
  done
  mv -- "${DIR}/${TMP_NAME}.age" "${DIR}/${name}-otp.age"
  notify-send "Successfully added." "${name}-otp has been created."
}

sync_time() {
  local update
  need ntpdate sudo

  notify-send -u low "🕙 Synchronizing Time..." \
    "Synching time with remote NTP servers..."
  update=$(sudo ntpdate pool.ntp.org) || exit 1
  notify-send -u low "🕙 Synchronizing Time..." \
    "Done. Time changed by ${update#*offset }"
}

main() {
  local choice
  need paotp dmenu xdotool notify-send

  choice=$(list_choices | dmenu -p "Pick a 2FA:") || exit

  case ${choice} in
  '🆕add') add_otp ;;
  '🕙sync-time') sync_time ;;
  *) paotp c "${choice}-otp" | xdotool type --clearmodifiers --file - ;;
  esac
}

main "$@"
