#!/bin/sh
#
# prompt for a password via dmenu
# generate new password if it doesn't exist
# then type the selected password (or OTP) via xdotool

show() {
  case "$1" in
  *-otp)
    paotp c "$1"
    ;;
  *)
    pa s "$1" || { printf y | pa a "$1" >/dev/null && pa s "$1"; }
    ;;
  esac
}

paste() {
  head -n 1 | tr -d '\n' | xdotool type --clearmodifiers --file -
}

main() {
  local name=$(pa l | dmenu "$@") || exit
  show "$name" | paste
}

main
