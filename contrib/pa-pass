#!/usr/bin/env bash
#
# Migrate passwords from pass to pa.
#
# password dir of pass: export PASSWORD_STORE_DIR=~/.password-store
# store dir of pa:      export PA_DIR=~/.local/share/pa
#
# Requires: pa, gpg2, age or rage.

set -o pipefail

err() {
  printf '%s: %s.\n' "${0##*/}" "$1" >&2
}

die() {
  err "$1"
  exit 1
}

main() {
  local age passfile name dest

  : "${PASSWORD_STORE_DIR:=${HOME}/.password-store}"
  : "${PA_DIR:=${XDG_DATA_HOME:-${HOME}/.local/share}/pa}"

  [[ -d ${PASSWORD_STORE_DIR} ]] ||
    die "pass store '${PASSWORD_STORE_DIR}' doesn't exist"

  pa l >/dev/null || die "couldn't initialize the pa store"

  age=$(command -v age || command -v rage) || die "age or rage is required"

  # shellcheck disable=SC2312 # store dir checked above
  while IFS= read -rd '' passfile; do
    name=${passfile#"${PASSWORD_STORE_DIR}/"}
    name=${name%.gpg}
    dest=${PA_DIR}/passwords/${name}.age
    mkdir -p "${dest%/*}"
    gpg2 -d "${passfile}" |
      "${age}" -R "${PA_DIR}/recipients" -o "${dest}" &&
      printf '%s\n' "saved '${name}' to the store."
  done < <(find "${PASSWORD_STORE_DIR}" -name '*.gpg' -print0)

  if [[ ! -v PA_NOGIT ]] && command -v git >/dev/null; then
    git -C "${PA_DIR}/passwords" add .
    git -C "${PA_DIR}/passwords" commit -m "migrate from pass"
  fi
}

main "$@"
