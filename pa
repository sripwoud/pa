#!/usr/bin/env bash
set -o pipefail
#
# pa - a simple password manager

pw_add() {
  if yn "generate a password?"; then
    pass=$(rand_chars "$PA_LENGTH" "$PA_PATTERN") ||
      die "couldn't generate a password"
  else
    sread pass "enter a password"

    [[ -n $pass ]] ||
      die "password can't be empty"

    sread pass2 "enter a password (again)"

    # shellcheck disable=2154
    [[ $pass == "$pass2" ]] ||
      die "passwords don't match"
  fi

  mkdir -p "$(dirname "./$name")" ||
    die "couldn't create category '$(dirname "./$name" | cut -c3-)'"

  # A heredoc is used here instead of a 'printf' to avoid
  # leaking the password through the '/proc' filesystem.
  encrypt "./$name.age" <<-EOF
		$pass
	EOF

  printf '%s\n' "saved '$name' to the store." >&2

  $git_enabled && git_add_and_commit "./$name.age" "add '$name'"
}

pw_edit() {
  # Prefer /dev/shm because it's an in-memory
  # space that we can use to store data without
  # having bits laying around in sectors.
  tmpdir=/dev/shm
  # Fall back to /tmp - /dev/shm is Linux-only & /tmp
  # and shared memory space on other operating systems
  # have non-standard methods of setup/access.
  [[ -w /dev/shm ]] || tmpdir=/tmp

  tmpfile=$(mktemp "${tmpdir}/pa.XXXXXX") ||
    die "couldn't create a shared memory file"

  trap 'rm -f "$tmpfile"' EXIT

  if [[ ! -f "$name.age" ]]; then
    new=true
  else
    new=false
    decrypt -o "$tmpfile" "./$name.age"
  fi

  ${EDITOR:-vi} "$tmpfile" ||
    die "EDITOR exited non-zero"

  [[ -s "$tmpfile" ]] && {
    mkdir -p "$(dirname "./$name")" ||
      die "couldn't create category '$(dirname "./$name" | cut -c3-)'"

    encrypt "./$name.age" "$tmpfile"

    if $new; then printf '%s\n' "saved '$name' to the store." >&2; fi

    $git_enabled && git_add_and_commit "./$name.age" "edit '$name'"
  }
}

pw_del() {
  yn "delete password '$name'?" && {
    rm -f "./$name.age"

    rmdir -p "$(dirname "./$name")" 2>/dev/null || :

    $git_enabled && git_add_and_commit "./$name.age" "delete '$name'"
  }
}

pw_rand() {
  local password
  password=$(rand_chars "${1:-$PA_LENGTH}" "${2:-$PA_PATTERN}")
  printf '%s\n' "$password"
  if command -v xclip >/dev/null 2>&1; then
    printf '%s' "$password" | xclip -selection clipboard
    printf '%s\n' "password copied to clipboard" >&2
  fi
}

pw_show() {
  decrypt "./$name.age"
}

pw_qr() {
  pw_show | qrencode -t utf8
}

pw_list() {
  local dir="."
  [[ -n $name ]] && dir="./$name"
  find "$dir" -type f -name \*.age | sed 's|^\./||;s/\.age$//' | sort
}

pw_move() {
  mkdir -p "$(dirname "./$name")" ||
    die "couldn't create category '$(dirname "./$name" | cut -c3-)'"

  mv -- "./$src.age" "./$name.age"

  rmdir -p "$(dirname "./$src")" 2>/dev/null || :

  if $git_enabled; then
    git rm -q "./$src.age"
    git_add_and_commit "./$name.age" "move '$src' to '$name'"
  fi
}

encrypt() {
  local outfile="$1"
  shift
  $age --encrypt -R "$recipients_file" -o "$outfile" "$@" ||
    die "couldn't encrypt $outfile"
}

decrypt() {
  $age --decrypt -i "$identities_file" "$@" ||
    die "decryption failed"
}

otp_check_tools() {
  command -v oathtool >/dev/null 2>&1 ||
    die "oathtool not found, install oath-toolkit"
}

otp_parse_uri() {
  local uri rest query param key value

  # shellcheck disable=2034
  otp_uri="" otp_type="" otp_label="" otp_secret=""
  # shellcheck disable=2034
  otp_algorithm="SHA1" otp_digits="6" otp_period="30"
  otp_counter="0" otp_issuer=""

  uri="$1"
  # shellcheck disable=2034
  otp_uri="$uri"

  [[ $uri == otpauth://* ]] ||
    die "invalid OTP URI: must start with otpauth://"

  rest="${uri#otpauth://}"
  otp_type="${rest%%/*}"
  rest="${rest#*/}"
  otp_label="${rest%%\?*}"
  query="${rest#*\?}"

  local -a params
  IFS='&' read -ra params <<< "$query"
  for param in "${params[@]}"; do
    key="${param%%=*}"
    value="${param#*=}"
    # shellcheck disable=2034
    case "$key" in
    secret) otp_secret="$value" ;;
    digits) otp_digits="$value" ;;
    algorithm) otp_algorithm="${value^^}" ;;
    period) otp_period="$value" ;;
    counter) otp_counter="$value" ;;
    issuer) otp_issuer="$value" ;;
    *) ;;
    esac
  done

  [[ -n $otp_secret ]] || die "OTP URI missing secret"
}

otp_insert() {
  local uri

  [[ -f ./$name.age ]] && {
    yn "overwrite otp '$name'?" || die "aborted"
  }

  printf 'enter OTP URI: '
  read -r uri || die "no input"

  otp_parse_uri "$uri"

  printf '%s\n' "$uri" | encrypt "./$name.age"

  printf '%s\n' "saved otp '$name' to the store." >&2

  $git_enabled && git_add_and_commit "./$name.age" "add otp '$name'"
}

otp_code() {
  local uri otp_line otp_code new_counter new_uri

  [[ -f ./$name.age ]] || die "otp '$name' doesn't exist"

  uri=$(decrypt "./$name.age")
  otp_line=$(grep '^otpauth://' <<<"$uri")
  [[ -n $otp_line ]] || die "no OTP URI found in '$name'"

  otp_parse_uri "$otp_line"

  case "$otp_type" in
  totp)
    otp_code=$(oathtool --totp -b "$otp_secret" \
      --digits="$otp_digits" --time-step-size="$otp_period") ||
      die "oathtool failed"
    ;;
  hotp)
    new_counter=$((otp_counter + 1))
    otp_code=$(oathtool --hotp -b --counter="$new_counter" \
      "$otp_secret" --digits="$otp_digits") ||
      die "oathtool failed"
    new_uri=$(printf 'otpauth://hotp/%s?secret=%s&counter=%s' \
      "$otp_label" "$otp_secret" "$new_counter")
    [[ -n $otp_issuer ]] &&
      new_uri=$(printf '%s&issuer=%s' "$new_uri" "$otp_issuer")
    printf '%s\n' "$new_uri" | encrypt "./$name.age"
    $git_enabled && git_add_and_commit "./$name.age" "increment HOTP counter for '$name'"
    ;;
  *) die "unsupported OTP type: $otp_type" ;;
  esac

  printf '%s\n' "$otp_code"
}

otp_uri() {
  local uri otp_line

  [[ -f ./$name.age ]] || die "otp '$name' doesn't exist"

  uri=$(decrypt "./$name.age")
  otp_line=$(grep '^otpauth://' <<<"$uri")
  [[ -n $otp_line ]] || die "no OTP URI found in '$name'"

  printf '%s\n' "$otp_line"
}

otp_validate() {
  otp_parse_uri "$1"
  printf '%s\n' "valid OTP URI." >&2
}

otp_usage() {
  printf %s "\
  pa otp
    manage one-time passwords

  commands:
    [i]nsert [name]  - Add an OTP entry (reads URI from stdin).
    [c]ode   [name]  - Generate a one-time code.
    [u]ri    [name]  - Show the stored OTP URI.
    [v]alidate [uri] - Validate an OTP URI.

  shortcuts:
    pa oi [name]     - Same as pa otp insert.
    pa oc [name]     - Same as pa otp code.
    pa ou [name]     - Same as pa otp uri.
    pa ov [uri]      - Same as pa otp validate.
"
  exit 0
}

git_add_and_commit() {
  git add "$1" ||
    die "couldn't git add $1"

  git commit -qm "$2" ||
    die "couldn't git commit $2"
}

rand_chars() {
  # Generate random characters by reading '/dev/urandom' with the
  # 'tr' command to translate the random bytes into a
  # configurable character set.
  #
  # Regarding usage of '/dev/urandom' instead of '/dev/random'.
  # See: https://www.2uo.de/myths-about-urandom
  #
  # $1 = number of chars to receive
  # $2 = filter for the chars
  local result
  IFS= read -rN "$1" result < <(LC_ALL=C tr -dc "$2" </dev/urandom)
  printf '%s' "$result"
}

yn() {
  printf '%s [y/N]: ' "$1"

  read -rn1 answer

  printf '%s\n' "$answer"

  [[ $answer == [yY] ]]
}

sread() {
  printf '%s: ' "$2"

  read -rs "$1"

  printf '\n'
}

die() {
  printf '%s: %s.\n' "$(basename "$0")" "$1" >&2
  exit 1
}

usage() {
  printf %s "\
  pa
    a simple password manager

  commands:
    [a]dd  [name]             - Add a password entry.
    [d]el  [name]             - Delete a password entry.
    [e]dit [name]             - Edit a password entry with ${EDITOR:-vi}.
    [g]it  [cmd]              - Run git command in the password dir.
    [l]ist [category]         - List all entries (or those in a category).
    [m]ove [src] [name]       - Rename a password entry.
    [s]how [name]             - Show password for an entry.
    [r]and [length] [pattern] - Generate a random password.
    [q]r [name]               - Show password as QR code.

  otp commands:
    [o]tp [i]nsert [name]     - Add an OTP entry (reads URI from stdin).
    [o]tp [c]ode   [name]     - Generate a one-time code.
    [o]tp [u]ri    [name]     - Show the stored OTP URI.
    [o]tp [v]alidate [uri]    - Validate an OTP URI.

  otp shortcuts:
    oi [name]                 - Same as otp insert.
    oc [name]                 - Same as otp code.
    ou [name]                 - Same as otp uri.
    ov [uri]                  - Same as otp validate.

  env vars:
    data directory:   export PA_DIR=~/.local/share/pa
    password length:  export PA_LENGTH=50
    password pattern: export PA_PATTERN=A-Za-z0-9-_
    disable tracking: export PA_NOGIT=
"
  exit 0
}

main() {
  age=$(command -v age || command -v rage) ||
    die "age not found, install per https://age-encryption.org"

  age_keygen=$(command -v age-keygen || command -v rage-keygen) ||
    die "age-keygen not found, install per https://age-encryption.org"

  : "${PA_DIR:=${XDG_DATA_HOME:-$HOME/.local/share}/pa}"
  : "${PA_LENGTH:=50}"
  : "${PA_PATTERN:=A-Za-z0-9-_}"

  [[ $PA_DIR == /* ]] ||
    die "PA_DIR must be an absolute path (got '$PA_DIR')"

  identities_file=$PA_DIR/identities
  recipients_file=$PA_DIR/recipients

  mkdir -p "$PA_DIR/passwords" ||
    die "couldn't create pa directories"

  cd "$PA_DIR/passwords" ||
    die "couldn't change to password directory"

  # Ensure that globbing is disabled
  # to avoid insecurities with word-splitting.
  set -f

  git_enabled=false
  [[ -z ${PA_NOGIT+x} ]] && command -v git >/dev/null 2>&1 && git_enabled=true

  $git_enabled && [[ ! -d .git ]] && {
    git init -q

    # Put something in user config if it's not set globally,
    # because git doesn't allow to commit without it.
    git config user.name >/dev/null || git config user.name pa
    git config user.email >/dev/null || git config user.email ""

    # Configure diff driver for age encrypted files that treats them as
    # binary and decrypts them when a human-readable diff is requested.
    git config diff.age.binary true
    git config diff.age.textconv "$age --decrypt -i '$identities_file'"

    # Assign this diff driver to all passwords.
    printf '%s\n' '*.age diff=age' >.gitattributes

    git_add_and_commit . "initial commit"
  }

  cmd=$1
  shift

  [[ $cmd == g* ]] && {
    git "$@"
    exit $?
  }

  # OTP shortcuts: pa oi, pa oc, pa ou, pa ov
  case $cmd in
  oi)
    otp_check_tools
    name=$(printf %s "$*" | LC_ALL=C tr -d '[:cntrl:]')
    otp_insert
    exit $?
    ;;
  oc)
    otp_check_tools
    name=$(printf %s "$*" | LC_ALL=C tr -d '[:cntrl:]')
    otp_code
    exit $?
    ;;
  ou)
    otp_check_tools
    name=$(printf %s "$*" | LC_ALL=C tr -d '[:cntrl:]')
    otp_uri
    exit $?
    ;;
  ov)
    otp_check_tools
    otp_validate "$1"
    exit $?
    ;;
  esac

  # OTP subcommand: pa otp <cmd> [name]
  [[ $cmd == o* ]] && {
    otp_check_tools
    otp_cmd=$1
    shift
    name=$(printf %s "$*" | LC_ALL=C tr -d '[:cntrl:]')
    case $otp_cmd in
    i*) otp_insert ;;
    c*) otp_code ;;
    u*) otp_uri ;;
    v*) otp_validate "$name" ;;
    *) otp_usage ;;
    esac
    exit $?
  }

  [[ $cmd == m* ]] && {
    src=$(printf %s "$1" | LC_ALL=C tr -d '[:cntrl:]')
    [[ -n $src ]] || die "missing [src] argument"
    shift
  }

  # Combine the rest of positional arguments into
  # a name and remove control characters from it
  # so that a name can always be safely displayed.
  name=$(printf %s "$*" | LC_ALL=C tr -d '[:cntrl:]')

  [[ $cmd == [adesm]* ]] && [[ -z $name ]] &&
    die "missing [name] argument"

  [[ $name == /* || $name == */ ]] &&
    die "name can't start or end with '/'"

  [[ $name == ../* || $name == */../* ]] &&
    die "category went out of bounds"

  [[ $cmd == m* ]] && [[ $src == /* || $src == */ ]] &&
    die "name can't start or end with '/'"

  [[ $cmd == m* ]] && [[ $src == ../* || $src == */../* ]] &&
    die "category went out of bounds"

  [[ $cmd == m* ]] && [[ ! -f ./$src.age ]] &&
    die "password '$src' doesn't exist"

  [[ $cmd == [am]* ]] && [[ -f $name.age ]] &&
    die "password '$name' already exists"

  [[ $cmd == [ds]* ]] && [[ ! -f $name.age ]] &&
    die "password '$name' doesn't exist"

  [[ $cmd == l* ]] && [[ -n $name ]] && [[ ! -d ./$name ]] &&
    die "category '$name' doesn't exist"

  [[ $cmd == l* ]] && [[ $name == /* ]] &&
    die "category can't start with '/'"

  if command -v age-plugin-yubikey >/dev/null 2>&1; then
    [[ ! -f $identities_file ]] && [[ ! -f $recipients_file ]] && {
      yn "generate yubikey identity?" && {
        age-plugin-yubikey \
          --generate \
          --name "pa identity" \
          --pin-policy never \
          --touch-policy always >"$identities_file" ||
          die 'failed to generate YubiKey identity file'

        age-plugin-yubikey -l >"$recipients_file" ||
          die 'failed to generate YubiKey recipients file'
      }
    }
  fi

  [[ -f $identities_file ]] ||
    $age_keygen -o "$identities_file" 2>/dev/null

  [[ -f $recipients_file ]] ||
    $age_keygen -y -o "$recipients_file" "$identities_file" 2>/dev/null

  # Ensure that we leave the terminal in a usable state on Ctrl+C.
  [[ -t 0 ]] && trap 'trap - INT; kill -s INT 0' INT

  case $cmd in
  a*) pw_add ;;
  d*) pw_del ;;
  e*) pw_edit ;;
  l*) pw_list ;;
  m*) pw_move ;;
  s*) pw_show ;;
  r*) pw_rand "$@" ;;
  q*) pw_qr ;;
  *) usage ;;
  esac
}

# Ensure that debug mode is never enabled to
# prevent the password from leaking.
set +x

# Restrict permissions of any new files to
# only the current user.
umask 077

[[ $1 ]] || usage
main "$@"
