#!/usr/bin/env bash
#
# pa - a simple password manager

set -o pipefail

readonly VERSION='pa 0.1.0'
readonly DEFAULT_LENGTH=50
readonly DEFAULT_PATTERN='A-Za-z0-9-_'

pw_add() {
  local pass pass2

  if yn "generate a password?"; then
    pass=$(rand_chars "${PA_LENGTH}" "${PA_PATTERN}") ||
      die "couldn't generate a password"
  else
    sread pass "enter a password"

    [[ -n ${pass} ]] ||
      die "password can't be empty"

    sread pass2 "enter a password (again)"

    [[ ${pass} == "${pass2}" ]] ||
      die "passwords don't match"
  fi

  mk_category "${name}"

  # A heredoc is used here instead of a 'printf' to avoid
  # leaking the password through the '/proc' filesystem.
  encrypt "./${name}.age" <<-EOF
		${pass}
	EOF

  printf '%s\n' "saved '${name}' to the store." >&2

  if ((git_enabled)); then git_add_and_commit "./${name}.age" "add '${name}'"; fi
}

pw_insert() {
  local pass
  local hint="pipe it in (e.g. 'pa rand | pa insert ${name}')"
  [[ -t 0 ]] &&
    die "insert reads the password from stdin, ${hint} or use 'pa add ${name}'"

  pass=$(cat) || die "couldn't read stdin"

  [[ -n ${pass} ]] ||
    die "password can't be empty"

  mk_category "${name}"

  encrypt "./${name}.age" <<-EOF
		${pass}
	EOF

  printf '%s\n' "saved '${name}' to the store." >&2

  if ((git_enabled)); then git_add_and_commit "./${name}.age" "add '${name}'"; fi
}

# Decrypt the entry (if any) into an in-memory temp file, open it in
# EDITOR, and re-encrypt it unless the editor left the file empty.
pw_edit() {
  local tmpfile
  local is_new=0

  mk_tmpfile tmpfile

  if [[ -f "${name}.age" ]]; then
    decrypt -o "${tmpfile}" "./${name}.age"
  else
    is_new=1
  fi

  run_editor "${tmpfile}"

  [[ -s "${tmpfile}" ]] && {
    mk_category "${name}"

    encrypt "./${name}.age" "${tmpfile}"

    if ((is_new)); then printf '%s\n' "saved '${name}' to the store." >&2; fi

    if ((git_enabled)); then
      git_add_and_commit "./${name}.age" "edit '${name}'"
    fi
  }
}

pw_del() {
  local path="./${name}"

  yn "delete password '${name}'?" && {
    rm -f "${path}.age"

    rmdir -p "${path%/*}" 2>/dev/null || :

    if ((git_enabled)); then
      git_add_and_commit "${path}.age" "delete '${name}'"
    fi
  }
}

pw_rand() {
  local password
  password=$(rand_chars "${1:-${PA_LENGTH}}" "${2:-${PA_PATTERN}}")
  printf '%s\n' "${password}"
  if command -v xclip >/dev/null 2>&1; then
    printf '%s' "${password}" | xclip -selection clipboard
    printf '%s\n' "password copied to clipboard" >&2
  fi
}

pw_show() {
  decrypt "./${name}.age"
}

pw_qr() {
  pw_show | qrencode -t utf8
}

pw_list() {
  local dir="."
  [[ -n ${name} ]] && dir="./${name}"
  find "${dir}" -type f -name \*.age | sed 's|^\./||;s/\.age$//' | sort
}

pw_meta() {
  local tmpfile

  mk_category "${name}"

  mk_tmpfile tmpfile

  printf '%s\n\n' "na" >"${tmpfile}"

  run_editor +2 "${tmpfile}"

  [[ -s "${tmpfile}" ]] || die "empty meta entry, aborting"

  encrypt "./${name}.age" "${tmpfile}"

  printf '%s\n' "saved meta '${name}' to the store." >&2

  if ((git_enabled)); then
    git_add_and_commit "./${name}.age" "add meta '${name}'"
  fi
}

pw_move() {
  local src_path="./${src}"

  mk_category "${name}"

  mv -- "${src_path}.age" "./${name}.age"

  rmdir -p "${src_path%/*}" 2>/dev/null || :

  if ((git_enabled)); then
    git rm -q "${src_path}.age"
    git_add_and_commit "./${name}.age" "move '${src}' to '${name}'"
  fi
}

mk_category() {
  local path="./$1"
  mkdir -p "${path%/*}" ||
    die "couldn't create category '${1%/*}'"
}

# Create a temp file, preferring in-memory /dev/shm, store its path in
# the variable named by $1, and remove it on exit.
mk_tmpfile() {
  local -n tmpfile_ref=$1
  local dir=/dev/shm
  [[ -w ${dir} ]] || dir=/tmp

  tmpfile_ref=$(mktemp "${dir}/pa.XXXXXX") ||
    die "couldn't create a shared memory file"

  # shellcheck disable=SC2064 # expand now: the caller's local is gone at exit
  trap "rm -f -- ${tmpfile_ref@Q}" EXIT
}

run_editor() {
  local -a editor
  read -ra editor <<<"${EDITOR:-vi}"
  "${editor[@]}" "$@" ||
    die "EDITOR exited non-zero"
}

encrypt() {
  local outfile="$1"
  shift
  "${age}" --encrypt -R "${recipients_file}" -o "${outfile}" "$@" ||
    die "couldn't encrypt ${outfile}"
}

decrypt() {
  "${age}" --decrypt -i "${identities_file}" "$@" ||
    die "decryption failed"
}

otp_check_tools() {
  command -v oathtool >/dev/null 2>&1 ||
    die "oathtool not found, install oath-toolkit"
}

# Parse an otpauth:// URI ($2) into the associative array named by $1:
# type, label, secret, algorithm, digits, period, counter, issuer.
otp_parse_uri() {
  local -n otp_ref=$1
  local uri=$2 rest query param value
  local -a params

  [[ ${uri} == otpauth://* ]] ||
    die "invalid OTP URI: must start with otpauth://"

  otp_ref=(["algorithm"]=SHA1 ["digits"]=6 ["period"]=30 ["counter"]=0 ["issuer"]="")

  rest="${uri#otpauth://}"
  otp_ref["type"]="${rest%%/*}"
  rest="${rest#*/}"
  otp_ref["label"]="${rest%%\?*}"
  query="${rest#*\?}"

  IFS='&' read -ra params <<<"${query}"
  for param in "${params[@]}"; do
    value="${param#*=}"
    case "${param%%=*}" in
    secret) otp_ref["secret"]="${value}" ;;
    digits) otp_ref["digits"]="${value}" ;;
    algorithm) otp_ref["algorithm"]="${value^^}" ;;
    period) otp_ref["period"]="${value}" ;;
    counter)
      [[ ${value} =~ ^[0-9]+$ ]] || die "OTP URI counter must be a number"
      otp_ref["counter"]="${value}"
      ;;
    issuer) otp_ref["issuer"]="${value}" ;;
    *) ;;
    esac
  done

  [[ -n ${otp_ref["secret"]} ]] || die "OTP URI missing secret"
}

otp_insert() {
  local uri
  local -A otp

  [[ -f ./${name}.age ]] && {
    yn "overwrite otp '${name}'?" || die "aborted"
  }

  printf 'enter OTP URI: '
  read -r uri || die "no input"

  otp_parse_uri otp "${uri}"

  printf '%s\n' "${uri}" | encrypt "./${name}.age"

  printf '%s\n' "saved otp '${name}' to the store." >&2

  if ((git_enabled)); then
    git_add_and_commit "./${name}.age" "add otp '${name}'"
  fi
}

otp_code() {
  local uri otp_line code new_counter new_uri
  local -A otp

  [[ -f ./${name}.age ]] || die "otp '${name}' doesn't exist"

  uri=$(decrypt "./${name}.age")
  otp_line=$(grep '^otpauth://' <<<"${uri}")
  [[ -n ${otp_line} ]] || die "no OTP URI found in '${name}'"

  otp_parse_uri otp "${otp_line}"

  case "${otp[type]}" in
  totp)
    code=$(oathtool --totp -b "${otp[secret]}" \
      --digits="${otp[digits]}" --time-step-size="${otp[period]}") ||
      die "oathtool failed"
    ;;
  hotp)
    new_counter=$((10#${otp[counter]} + 1))
    code=$(oathtool --hotp -b --counter="${new_counter}" \
      "${otp[secret]}" --digits="${otp[digits]}") ||
      die "oathtool failed"
    new_uri=$(printf 'otpauth://hotp/%s?secret=%s&counter=%s' \
      "${otp[label]}" "${otp[secret]}" "${new_counter}")
    [[ -n ${otp[issuer]} ]] &&
      new_uri=$(printf '%s&issuer=%s' "${new_uri}" "${otp[issuer]}")
    printf '%s\n' "${new_uri}" | encrypt "./${name}.age"
    if ((git_enabled)); then
      git_add_and_commit "./${name}.age" "increment HOTP counter for '${name}'"
    fi
    ;;
  *) die "unsupported OTP type: ${otp[type]}" ;;
  esac

  printf '%s\n' "${code}"
}

otp_uri() {
  local uri otp_line

  [[ -f ./${name}.age ]] || die "otp '${name}' doesn't exist"

  uri=$(decrypt "./${name}.age")
  otp_line=$(grep '^otpauth://' <<<"${uri}")
  [[ -n ${otp_line} ]] || die "no OTP URI found in '${name}'"

  printf '%s\n' "${otp_line}"
}

otp_validate() {
  local -A otp
  otp_parse_uri otp "$1"
  printf '%s\n' "valid OTP URI." >&2
}

otp_usage() {
  printf %s "\
  pa otp
    manage one-time passwords

  commands:
    [i]nsert [name]  - Add an OTP entry (reads URI from stdin).
    [c]ode   [name]  - Generate a one-time code.
    [u]ri    [name]  - Show the stored OTP URI.
    [v]alidate [uri] - Validate an OTP URI.

  shortcuts:
    pa oi [name]     - Same as pa otp insert.
    pa oc [name]     - Same as pa otp code.
    pa ou [name]     - Same as pa otp uri.
    pa ov [uri]      - Same as pa otp validate.
"
  exit 0
}

git_add_and_commit() {
  git add "$1" ||
    die "couldn't git add $1"

  git commit -qm "$2" ||
    die "couldn't git commit $2"
}

# Print $1 random chars from the tr set $2, read from /dev/urandom.
# See https://www.2uo.de/myths-about-urandom for urandom vs random.
rand_chars() {
  local result
  # shellcheck disable=SC2312 # tr dies of SIGPIPE once read has $1 chars
  IFS= read -rN "$1" result < <(LC_ALL=C tr -dc "$2" </dev/urandom)
  printf '%s' "${result}"
}

sanitize_name() {
  printf %s "$*" | LC_ALL=C tr -d '[:cntrl:]'
}

yn() {
  local answer

  printf '%s [y/N]: ' "$1"

  read -rn1 answer

  printf '%s\n' "${answer}"

  [[ ${answer} == [yY] ]]
}

sread() {
  printf '%s: ' "$2"

  read -rs "$1"

  printf '\n'
}

err() {
  printf '%s: %s.\n' "${0##*/}" "$1" >&2
}

die() {
  err "$1"
  exit 1
}

usage() {
  printf %s "\
  pa
    a simple password manager

  commands:
    a|add  [name]             - Add a password entry.
    d|del  [name]             - Delete a password entry.
    e|edit [name]             - Edit a password entry with ${EDITOR:-vi}.
    g|git  [cmd]              - Run git command in the password dir.
    i|insert [name]           - Add a password entry from stdin.
    l|list [category]         - List all entries (or those in a category).
    me|meta [name]            - Add a metadata entry (name/meta).
    m|move [src] [name]       - Rename a password entry.
    q|qr   [name]             - Show password as QR code.
    r|rand [length] [pattern] - Generate a random password.
    s|show [name]             - Show password for an entry.

  otp commands:
    o|otp i|insert [name]     - Add an OTP entry (reads URI from stdin).
    o|otp c|code   [name]     - Generate a one-time code.
    o|otp u|uri    [name]     - Show the stored OTP URI.
    o|otp v|validate [uri]    - Validate an OTP URI.

  otp shortcuts:
    oi [name]                 - Same as otp insert.
    oc [name]                 - Same as otp code.
    ou [name]                 - Same as otp uri.
    ov [uri]                  - Same as otp validate.

  env vars:
    data directory:   export PA_DIR=~/.local/share/pa
    password length:  export PA_LENGTH=${DEFAULT_LENGTH}
    password pattern: export PA_PATTERN=${DEFAULT_PATTERN}
    disable tracking: export PA_NOGIT=
"
  exit 0
}

main() {
  local age age_keygen identities_file recipients_file
  local cmd otp_cmd name src
  local git_enabled=0

  # Ensure that debug mode is never enabled to
  # prevent the password from leaking.
  set +x

  # Restrict permissions of any new files to
  # only the current user.
  umask 077

  [[ -n $1 ]] || usage

  case $1 in
  -h | --help) usage ;;
  -v | --version)
    printf '%s\n' "${VERSION}"
    return 0
    ;;
  *) ;;
  esac

  age=$(command -v age || command -v rage) ||
    die "age not found, install per https://age-encryption.org"

  age_keygen=$(command -v age-keygen || command -v rage-keygen) ||
    die "age-keygen not found, install per https://age-encryption.org"

  : "${PA_DIR:=${XDG_DATA_HOME:-${HOME}/.local/share}/pa}"
  : "${PA_LENGTH:=${DEFAULT_LENGTH}}"
  : "${PA_PATTERN:=${DEFAULT_PATTERN}}"

  [[ ${PA_DIR} == /* ]] ||
    die "PA_DIR must be an absolute path (got '${PA_DIR}')"

  identities_file=${PA_DIR}/identities
  recipients_file=${PA_DIR}/recipients

  mkdir -p "${PA_DIR}/passwords" ||
    die "couldn't create pa directories"

  cd "${PA_DIR}/passwords" ||
    die "couldn't change to password directory"

  # Ensure that globbing is disabled
  # to avoid insecurities with word-splitting.
  set -f

  [[ -z ${PA_NOGIT+x} ]] && command -v git >/dev/null 2>&1 && git_enabled=1

  ((git_enabled)) && [[ ! -d .git ]] && {
    git init -q

    # Put something in user config if it's not set globally,
    # because git doesn't allow to commit without it.
    git config user.name >/dev/null || git config user.name pa
    git config user.email >/dev/null || git config user.email ""

    # Configure diff driver for age encrypted files that treats them as
    # binary and decrypts them when a human-readable diff is requested.
    git config diff.age.binary true
    git config diff.age.textconv "${age} --decrypt -i '${identities_file}'"

    # Assign this diff driver to all passwords.
    printf '%s\n' '*.age diff=age' >.gitattributes

    git_add_and_commit . "initial commit"
  }

  cmd=$1
  shift

  [[ ${cmd} == @(g|git) ]] && {
    git "$@"
    return
  }

  case ${cmd} in
  oi)
    otp_check_tools
    name=$(sanitize_name "$@")
    otp_insert
    return
    ;;
  oc)
    otp_check_tools
    name=$(sanitize_name "$@")
    otp_code
    return
    ;;
  ou)
    otp_check_tools
    name=$(sanitize_name "$@")
    otp_uri
    return
    ;;
  ov)
    otp_check_tools
    otp_validate "$1"
    return
    ;;
  o | otp)
    otp_check_tools
    otp_cmd=$1
    shift
    name=$(sanitize_name "$@")
    case ${otp_cmd} in
    i | insert) otp_insert ;;
    c | code) otp_code ;;
    u | uri) otp_uri ;;
    v | validate) otp_validate "${name}" ;;
    *) otp_usage ;;
    esac
    return
    ;;
  me | meta)
    name=$(sanitize_name "$@")
    [[ -n ${name} ]] || die "meta: missing [name] argument"
    name="${name}/meta"
    [[ ${name} == /* || ${name} == */ ]] &&
      die "name can't start or end with '/'"
    [[ ${name} == ../* || ${name} == */../* ]] &&
      die "category went out of bounds"
    [[ -f "./${name}.age" ]] && die "meta entry '${name}' already exists"
    pw_meta
    return
    ;;
  *) ;;
  esac

  [[ ${cmd} == @(m|move) ]] && {
    src=$(sanitize_name "$1")
    [[ -n ${src} ]] || die "missing [src] argument"
    shift
  }

  name=$(sanitize_name "$@")

  [[ ${cmd} == @(a|add|i|insert|d|del|e|edit|s|show|m|move) ]] &&
    [[ -z ${name} ]] &&
    die "${cmd}: missing [name] argument"

  [[ ${name} == /* || ${name} == */ ]] &&
    die "name can't start or end with '/'"

  [[ ${name} == ../* || ${name} == */../* ]] &&
    die "category went out of bounds"

  [[ ${cmd} == @(m|move) ]] && [[ ${src} == /* || ${src} == */ ]] &&
    die "move: source can't start or end with '/'"

  [[ ${cmd} == @(m|move) ]] && [[ ${src} == ../* || ${src} == */../* ]] &&
    die "move: source category went out of bounds"

  [[ ${cmd} == @(m|move) ]] && [[ ! -f ./${src}.age ]] &&
    die "password '${src}' doesn't exist"

  [[ ${cmd} == @(a|add|i|insert|m|move) ]] && [[ -f ${name}.age ]] &&
    die "password '${name}' already exists"

  [[ ${cmd} == @(d|del|s|show) ]] && [[ ! -f ${name}.age ]] &&
    die "password '${name}' doesn't exist"

  [[ ${cmd} == @(l|list) ]] && [[ -n ${name} ]] && [[ ! -d ./${name} ]] &&
    die "category '${name}' doesn't exist"

  [[ ${cmd} == @(l|list) ]] && [[ ${name} == /* ]] &&
    die "category can't start with '/'"

  if command -v age-plugin-yubikey >/dev/null 2>&1; then
    [[ ! -f ${identities_file} ]] && [[ ! -f ${recipients_file} ]] && {
      yn "generate yubikey identity?" && {
        age-plugin-yubikey \
          --generate \
          --name "pa identity" \
          --pin-policy never \
          --touch-policy always >"${identities_file}" ||
          die 'failed to generate YubiKey identity file'

        age-plugin-yubikey -l >"${recipients_file}" ||
          die 'failed to generate YubiKey recipients file'
      }
    }
  fi

  [[ -f ${identities_file} ]] ||
    "${age_keygen}" -o "${identities_file}" 2>/dev/null

  [[ -f ${recipients_file} ]] ||
    "${age_keygen}" -y -o "${recipients_file}" "${identities_file}" 2>/dev/null

  # Ensure that we leave the terminal in a usable state on Ctrl+C.
  [[ -t 0 ]] && trap 'trap - INT; kill -s INT 0' INT

  case ${cmd} in
  a | add) pw_add ;;
  d | del) pw_del ;;
  e | edit) pw_edit ;;
  i | insert) pw_insert ;;
  l | list) pw_list ;;
  m | move) pw_move ;;
  s | show) pw_show ;;
  r | rand) pw_rand "$@" ;;
  q | qr) pw_qr ;;
  *) usage ;;
  esac
}

main "$@"
