#compdef pa

_pa() {
    local state
    local -a names

    _arguments -C \
        '1: :->command' \
        '2: :->name'

    case $state in
        command)
            local -a commands
            commands=(
                'add:Add a password entry'
                'del:Delete a password entry'
                'edit:Edit a password entry'
                'git:Run git command in the password dir'
                'list:List all entries'
                'show:Show password for an entry'
            )
            _describe 'command' commands
            ;;
        name)
            if [[ $words[2] == (add|del|edit|show)* ]]; then
                names=(${(f)"$(_call_program names pa l)"})
                _describe 'name' names
            fi
            ;;
    esac
}

_pa "$@"
